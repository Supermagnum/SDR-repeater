# Regenerated simulation and extraction output. Keep decks and scripts.
**/out/*
# Keep the short text summaries of each run (owner rule 2026-10-25: all design files on GitHub)
!**/out/summary_*.txt
# P2.7+ layout deliverables (gds, renders, LVS spice, run logs — not raw .lyrdb)
# Parent dir must be re-included or git will not see children.
!**/layout/out/
!**/layout/out/*.gds.gz
!**/layout/out/*.png
!**/layout/out/*.svg
!**/layout/out/*_lvs.spice
!**/layout/out/*_run.log
!**/layout/out/drc_run.log
!**/layout/out/lvs_klayout_run.log
!**/layout/out/netgen_vco.log
!**/layout/out/netgen_vco.json
!**/layout/out/lvs_klayout/
!**/layout/out/lvs_klayout/*.cir
!**/layout/out/lvs_klayout/*.log
# P2.7.2 lettered sub-runs (p272a, p272b, …)
!**/layout/p272*/out/
!**/layout/p272*/out/*.gds.gz
!**/layout/p272*/out/*.png
!**/layout/p272*/out/*.svg
!**/layout/p272*/out/*.spice
!**/layout/p272*/out/*_extracted.cir
!**/layout/p272*/out/*_run.log
!**/layout/p272*/out/*.log
!**/layout/p272*/out/netgen_*.json
!**/layout/p272*/out/netgen_*.tcl
!**/layout/p272*/out/lvs_*/
!**/layout/p272*/out/lvs_*/*.cir
!**/layout/p272*/out/lvs_*/*.log
# keep ignoring bulky DRC databases and intermediate cell GDS
**/layout/out/drc/
**/layout/out/*.gds
**/layout/out/_*.py
**/layout/out/_*.drc
**/layout/p272*/out/*.gds
**/layout/p272*/out/_*.py
**/layout/p272*/out/drc_*/
sim/em/**/output/
sim/em/**/palace_model/
sim/em/**/vendor/
*.raw
*.vcd
*.fst
rtl/cocotb/sim_build/
rtl/digital/runs/
area_*.txt
signoff_*.txt
rtl/cocotb/test_backend_1j.py
*.orig
*.rej
analog/pn-validation/out_m*/
rf_toolcheck.txt
vacask_*.txt
rtl/afe/cocotb/sim_build/
rtl/afe/cocotb/results.xml
**/results.xml
