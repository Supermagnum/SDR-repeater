MdR gnd gnd gnd gnd sg13_lv_nmos w=0.5u l=0.13u ng=1
* hold caps
Cchold hold gnd cap_cmim w=16.270u l=16.270u m=1
Ccrep rep gnd cap_cmim w=16.270u l=16.270u m=1
* bias + PD [SCH retune]
Xrbias vdd nbias gnd rhigh w=0.5u l=78.000u ps=0u b=0 m=1
Mdiode nbias nbias pd_d gnd sg13_lv_nmos w=1.0u l=1.0u ng=1
