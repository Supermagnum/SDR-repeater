P2.7.1 vco_tail_dac
include "sg13g2_vacask_common.lib"
include "cornerMOSlv.lib" section=mos_tt
include "cornerMOShv.lib" section=mos_tt
include "cornerCAP.lib" section=cap_typ
load "resistor.osdi"
load "capacitor.osdi"
load "inductor.osdi"
model resistor resistor
model capacitor capacitor
model inductor inductor
model vsource vsource
model isource isource

imaster (pbias 0) isource dc=1.05e-05
mm0 (pbias pbias vdd vdd) sg13_lv_pmos w=2u l=2u ng=1
moff (xoff pbias vdd vdd) sg13_lv_pmos w=38u l=2u ng=19
msoff (xraw 0 xoff vdd) sg13_lv_pmos w=38u l=0.13u ng=1
mdb0 (xd0 pbias vdd vdd) sg13_lv_pmos w=2u l=2u ng=1
msw0 (xraw code0 xd0 vdd) sg13_lv_pmos w=2u l=0.13u ng=1
mdb1 (xd1 pbias vdd vdd) sg13_lv_pmos w=4u l=2u ng=2
msw1 (xraw code1 xd1 vdd) sg13_lv_pmos w=4u l=0.13u ng=1
mdb2 (xd2 pbias vdd vdd) sg13_lv_pmos w=8u l=2u ng=4
msw2 (xraw code2 xd2 vdd) sg13_lv_pmos w=8u l=0.13u ng=1
mdb3 (xd3 pbias vdd vdd) sg13_lv_pmos w=16u l=2u ng=8
msw3 (xraw code3 xd3 vdd) sg13_lv_pmos w=16u l=0.13u ng=1
mdb4 (xd4 pbias vdd vdd) sg13_lv_pmos w=32u l=2u ng=16
msw4 (xraw code4 xd4 vdd) sg13_lv_pmos w=32u l=0.13u ng=1
vsense (xraw xref) vsource dc=0
mr (xref nbf 0 0) sg13_lv_nmos w=60u l=4u ng=12
mt (tail nbf 0 0) sg13_lv_nmos w=480u l=4u ng=96
rtf (tail tail_f) resistor r=100000.0
ctf (tail_f 0) capacitor c=1e-12
mo1 (d1 xref ss 0) sg13_lv_nmos w=8u l=2u ng=2
mo2 (d2 tail_f ss 0) sg13_lv_nmos w=8u l=2u ng=2
iss (ss 0) isource dc=2e-05
mp1 (d1 d1 vdd vdd) sg13_lv_pmos w=4u l=2u ng=2
mp2 (d2 d1 vdd vdd) sg13_lv_pmos w=4u l=2u ng=2
rout (d2 nb) resistor r=1
rbf (nb nbf) resistor r=1000000.0
cbf (nbf 0) capacitor c=5e-11
rpd (nb 0) resistor r=200000.0
ctail (tail 0) capacitor c=8e-12
mbp_rbf (nb vbp_tail nbf 0) sg13_lv_nmos w=20u l=0.13u ng=4
