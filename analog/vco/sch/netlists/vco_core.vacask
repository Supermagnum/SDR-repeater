P2.7.1 vco_core
include "sg13g2_vacask_common.lib"
include "cornerMOSlv.lib" section=mos_tt
include "cornerMOShv.lib" section=mos_tt
include "cornerCAP.lib" section=cap_typ
load "resistor.osdi"
load "capacitor.osdi"
load "inductor.osdi"
model resistor resistor
model capacitor capacitor
model inductor inductor
model vsource vsource
model isource isource

m1 (tp tn tail 0) sg13_lv_nmos w=32u l=0.13u ng=8
m2 (tn tp tail 0) sg13_lv_nmos w=32u l=0.13u ng=8
xf1 (tp fx 0) cap_rfcmim w=16.246u l=16.246u
xf2 (tn fx 0) cap_rfcmim w=16.246u l=16.246u
rfx (fx 0) resistor r=200000.0
